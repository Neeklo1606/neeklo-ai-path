generator client {
  provider = "prisma-client-js"
}

// Production: PostgreSQL. Set DATABASE_URL in .env.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  passwordHash   String  @map("password_hash")
  name           String?
  role           Role    @default(MANAGER)
  createdAt      DateTime @default(now()) @map("created_at")
  uploadedMedia  Media[]

  @@map("app_users")
}

/// CMS page (JSON blocks)
model Page {
  id        String   @id @default(uuid())
  slug      String
  title     String   @default("")
  locale    String   @default("ru")
  blocks    Json
  meta      Json
  published Boolean  @default(false)
  isDraft   Boolean  @default(false) @map("is_draft")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  mediaUsages MediaUsage[]
  versions  PageVersion[]

  @@unique([slug, locale], name: "slug_locale")
  @@map("cms_pages")
}

/// Immutable snapshot before each content update (rollback / audit).
model PageVersion {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blocks    Json
  meta      Json
  /** true = interval autosave snapshot; false = manual save / restore safety snapshot */
  isAuto    Boolean  @default(false) @map("is_auto")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([pageId, createdAt])
  @@map("cms_page_versions")
}

model Media {
  id            String    @id @default(uuid())
  storagePath   String    @unique @map("storage_path")
  publicUrl     String    @map("public_url")
  thumbnailPath String?   @map("thumbnail_path")
  thumbnailUrl  String?   @map("thumbnail_url")
  mime          String?
  alt           String?
  width         Int?
  height        Int?
  thumbWidth    Int?      @map("thumb_width")
  thumbHeight   Int?      @map("thumb_height")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  sizeBytes        Int?      @map("size_bytes")
  uploadedByUserId String?   @map("uploaded_by_user_id")
  uploadedBy       User?     @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  usages           MediaUsage[]

  @@index([deletedAt])
  @@index([createdAt])
  @@index([uploadedByUserId])
  @@map("cms_media")
}

/// Indexed reference: which pages embed which media (`imageId` in blocks/meta).
model MediaUsage {
  id      String @id @default(cuid())
  mediaId String @map("media_id")
  pageId  String @map("page_id")
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([mediaId, pageId])
  @@index([mediaId])
  @@index([pageId])
  @@map("cms_media_usage")
}

model CmsSetting {
  key       String   @id
  value     Json?
  isPublic  Boolean  @default(false) @map("is_public")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cms_settings")
}

model Assistant {
  id             String   @id @default(uuid())
  name           String
  apiKeyHash     String   @map("api_key_hash")
  apiKeyPrefix   String   @default("") @map("api_key_prefix")
  provider       String   @default("ollama")
  baseUrl        String?  @map("base_url")
  model          String   @default("qwen2.5:7b")
  embedModel     String   @default("nomic-embed-text") @map("embed_model")
  systemPrompt   String?  @map("system_prompt")
  /** Ollama `options.temperature` */
  temperature    Float    @default(0.7)
  providerApiKey String?  @map("provider_api_key")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  chats          Chat[]
  prototypeJobs  PrototypeJob[]
  billingKey     ApiKey?

  @@map("cms_assistants")
}

/// Billing wallet per assistant (1:1). `key` = assistant id (opaque public ref).
model ApiKey {
  id          String    @id @default(uuid())
  key         String    @unique
  balance     Float     @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  assistantId String    @unique @map("assistant_id")
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  usageLogs   UsageLog[]

  @@map("billing_api_keys")
}

model UsageLog {
  id            String   @id @default(uuid())
  apiKeyId      String   @map("api_key_id")
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  tokensApprox  Int      @default(0) @map("tokens_approx")
  messagesCount Int      @default(1) @map("messages_count")
  cost          Float    @default(0)
  path          String   @default("chat")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([apiKeyId, createdAt])
  @@map("billing_usage_logs")
}

/// CRM: site visitors / contacts
model Lead {
  id             String   @id @default(uuid())
  name           String?
  phone          String?
  status         String   @default("new")
  readinessScore Int      @default(0) @map("readiness_score")
  intentLabel    String?  @map("intent_label")
  summary        String?  @map("summary")
  createdAt      DateTime @default(now()) @map("created_at")
  chats          Chat[]

  @@map("crm_leads")
}

/// Commercial offer (КП) for a specific client
model CommercialOffer {
  id               String    @id @default(cuid())
  slug             String    @unique
  clientName       String    @map("client_name")
  clientIndustry   String    @map("client_industry")
  kpNumber         String    @map("kp_number")
  expiresDays      Int       @default(14) @map("expires_days")
  published        Boolean   @default(false)

  heroData         Json      @map("hero_data")
  problemsData     Json      @map("problems_data")
  solutionData     Json      @map("solution_data")
  packagesData     Json      @map("packages_data")
  includedData     Json      @map("included_data")
  timelineData     Json      @map("timeline_data")
  nextPhaseData    Json      @map("next_phase_data")
  whyUsData        Json      @map("why_us_data")
  ctaData          Json      @map("cta_data")
  contactsData     Json      @map("contacts_data")

  viewsCount       Int       @default(0) @map("views_count")
  lastViewedAt     DateTime? @map("last_viewed_at")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("commercial_offers")
}

/// CRM: one chat thread; messages stored as JSON array
model Chat {
  id          String     @id @default(uuid())
  leadId      String?    @map("lead_id")
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assistantId String?    @map("assistant_id")
  assistant   Assistant? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  prototypeJobs PrototypeJob[]
  messages    Json       @default("[]")
  status      String     @default("active")
  operatorRequested Boolean @default(false) @map("operator_requested")
  operatorConnected Boolean @default(false) @map("operator_connected")
  aiPaused    Boolean    @default(false) @map("ai_paused")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([assistantId])
  @@index([updatedAt])
  @@map("crm_chats")
}

/// Async prototype generation job for public chat users
model PrototypeJob {
  id               String     @id @default(uuid())
  chatId           String?    @map("chat_id")
  chat             Chat?      @relation(fields: [chatId], references: [id], onDelete: SetNull)
  assistantId      String     @map("assistant_id")
  assistant        Assistant  @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  status           String     @default("queued")
  progress         Int        @default(0)
  briefText        String     @map("brief_text")
  normalizedBrief  Json?      @map("normalized_brief")
  resultSlug       String?    @map("result_slug")
  resultUrl        String?    @map("result_url")
  resultHtml       String?    @map("result_html")
  error            String?
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([chatId])
  @@index([assistantId, createdAt])
  @@index([status, updatedAt])
  @@unique([resultSlug])
  @@map("prototype_jobs")
}

/// Portfolio case / project for the public website
model Case {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  category    String   @default("Сайты")
  badge       String?
  description String?
  metric      String?
  url         String?
  color       String   @default("from-slate-100 to-zinc-200")
  coverImage  String?  @map("cover_image")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  videos      CaseVideo[]

  @@index([isActive, sortOrder])
  @@map("cases")
}

/// Blog article for the public website
model BlogPost {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  category        String    @default("AI")
  excerpt         String?
  content         String?
  coverImage      String?   @map("cover_image")
  readTime        String    @default("5 мин") @map("read_time")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  isPublished     Boolean   @default(false) @map("is_published")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

/// Video category for portfolio videos
model VideoCategory {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  sortOrder   Int         @default(0) @map("sort_order")
  videos      CaseVideo[]
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("video_categories")
}

/// Portfolio video linked to a case and category
model CaseVideo {
  id           Int            @id @default(autoincrement())
  title        String
  description  String?
  client       String?
  videoUrl     String         @map("video_url")
  thumbnailUrl String?        @map("thumbnail_url")
  duration     Int?
  fileSize     Int?           @map("file_size")
  categoryId   Int?           @map("category_id")
  category     VideoCategory? @relation(fields: [categoryId], references: [id])
  caseId       Int?           @map("case_id")
  case         Case?          @relation(fields: [caseId], references: [id])
  sortOrder    Int            @default(0) @map("sort_order")
  isPublished  Boolean        @default(true) @map("is_published")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([isPublished, categoryId])
  @@map("case_videos")
}

/// Full CRM contact (leads, clients)
model CrmContact {
  id         String        @id @default(cuid())
  name       String
  phone      String?
  telegram   String?
  email      String?
  company    String?
  source     String?       @default("website")
  score      Int           @default(0)
  status     String        @default("new")
  notes      String?       @db.Text
  assignee   String?
  tags       String?
  deals      CrmDeal[]
  activities CrmActivity[]
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("crm_contacts")
}

/// CRM deal for kanban board
model CrmDeal {
  id         String        @id @default(cuid())
  title      String
  contactId  String?       @map("contact_id")
  contact    CrmContact?   @relation(fields: [contactId], references: [id])
  stage      String        @default("new")
  amount     Int?
  currency   String        @default("RUB")
  service    String?
  priority   String        @default("medium")
  dueDate    DateTime?     @map("due_date")
  assignee   String?
  notes      String?       @db.Text
  color      String?
  sortOrder  Int           @default(0) @map("sort_order")
  activities CrmActivity[]
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("crm_deals")
}

/// Activity / note in timeline
model CrmActivity {
  id        String      @id @default(cuid())
  type      String      @default("note")
  text      String      @db.Text
  contactId String?     @map("contact_id")
  contact   CrmContact? @relation(fields: [contactId], references: [id])
  dealId    String?     @map("deal_id")
  deal      CrmDeal?    @relation(fields: [dealId], references: [id])
  author    String?
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("crm_activities")
}

/// Internal knowledge base article
model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  category    String   @default("general")
  tags        String?
  isPinned    Boolean  @default(false) @map("is_pinned")
  isPublished Boolean  @default(true)  @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("knowledge_articles")
}

/// Company regulation / SOP
model Regulation {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  category  String   @default("general")
  version   String   @default("1.0")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@map("regulations")
}
